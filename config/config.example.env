# Public config. bootstrap.sh copies this to config/.env (gitignored) on setup.
# NEVER put real secrets in this file — they arrive as GitHub Codespaces secrets
# (environment variables) and are written to config/.env + ~/.hermes/.env
# automatically by bootstrap.sh. Values below are safe defaults.

MODEL_PROVIDER=nvidia_nim       # nvidia_nim (default) | google | openrouter | openai | anthropic | glm | custom
MODEL_NAME=z-ai/glm-5.3
FALLBACK_PROVIDER=               # optional (e.g. openrouter); auto-filled only if that key exists
FALLBACK_MODEL=
TELEGRAM_MODE=hermes            # hermes = chat with Hermes on Telegram | control = task bot | off

# Hermes CLI / Telegram gateway model (written to ~/.hermes/config.yaml).
# Defaults: NVIDIA NIM + z-ai/glm-5.3. Override any time, e.g. as Codespaces secrets:
#   HERMES_PROVIDER=openrouter HERMES_MODEL=anthropic/claude-sonnet-4.5
#   HERMES_FALLBACK_PROVIDER=openrouter HERMES_FALLBACK_MODEL=google/gemini-3-flash-preview
#   HERMES_REASONING_EFFORT=high   HERMES_FORCE_MODEL=1 (reset after a manual `hermes model`)
BROWSER_MODE=headless         # headless | headed (headed needs xvfb-run)
WORK_DIR=/workspaces/hermes-codespace   # overwritten by bootstrap.sh with the real path
LOG_LEVEL=INFO
TARGET_URL=https://example.com
ALLOWED_DOMAINS=example.com   # comma-separated allowlist; anything else is refused
MAX_RETRIES=3
MAX_RETRY_DELAY=60
PARALLEL_TASKS=false
SCREENSHOT_LIMIT=200

# --- Everything below is supplied automatically via GitHub Codespaces secrets ---
# Repo -> Settings -> Secrets and variables -> Codespaces. bootstrap.sh detects
# them on every VM start and writes them here. There are NO setup questions /
# menus: the model provider and Telegram are configured automatically.
#
# Primary AI (top priority — with this key, GLM 5.3 is auto-configured end to end):
#   NVIDIA_NIM_API_KEY    build.nvidia.com (Get API Key) — aliases NVIDIA_API_KEY,
#                         NIM_API_KEY are also detected. Endpoint:
#                         https://integrate.api.nvidia.com/v1, model z-ai/glm-5.3
# Optional additional/fallback providers (auto-selected in this order after NVIDIA):
#   GEMINI_API_KEY        aistudio.google.com/apikey
#   OPENROUTER_API_KEY    openrouter.ai/keys
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, GLM_API_KEY
#   CUSTOM_BASE_URL + CUSTOM_API_KEY   (any other OpenAI-compatible API)
#   AI_API_KEY            (generic fallback for openai/anthropic/glm/custom)
# Telegram (optional — taken straight from secrets, never asked for):
#   TELEGRAM_BOT_TOKEN    from @BotFather — enables the control bot
#   TELEGRAM_CHAT_ID      chat id(s) allowed to command it (alias: TELEGRAM_CLIENT_ID)
# Target website (optional):
#   WEBSITE_CREDENTIALS   JSON credentials for the authorized site
