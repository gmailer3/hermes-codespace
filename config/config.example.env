# Public config. Copy to config/.env (gitignored). NEVER put secrets here.
MODEL_PROVIDER=google                      # google | openrouter | openai | ...
MODEL_NAME=gemini-3-flash-preview
FALLBACK_PROVIDER=openrouter               # used if the primary fails; blank = none
FALLBACK_MODEL=google/gemini-3-flash-preview
BROWSER_MODE=headless        # headless | headed (headed needs xvfb-run)
WORK_DIR=/workspaces/hermes-codespace
LOG_LEVEL=INFO
TARGET_URL=https://example.com
ALLOWED_DOMAINS=example.com  # comma-separated allowlist; anything else is refused
MAX_RETRIES=3
MAX_RETRY_DELAY=60
PARALLEL_TASKS=false
SCREENSHOT_LIMIT=200
# Secrets come from Codespaces Secrets:
#   GEMINI_API_KEY, OPENROUTER_API_KEY, (AI_API_KEY), WEBSITE_CREDENTIALS, TELEGRAM_BOT_TOKEN
